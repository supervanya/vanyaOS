{
  "name": "vanyaos",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p .claude/hooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "db:mirror": "bash scripts/db-mirror-prod.sh"
  },
