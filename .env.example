# Copy to .env.local (gitignored) and fill in.
# Local dev: run `bunx supabase start`, then use the URL + anon/publishable key it prints.
# Production: use the hosted project's URL + publishable key (Project Settings > API Keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional, dev server only: shows a one-tap "Dev sign-in" button on /login, so a
# re-added Home Screen app doesn't need a magic link. Use your *local* stack's
# user and password — never production credentials. Stripped from builds.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
